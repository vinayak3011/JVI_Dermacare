# Supabase -> Project Settings -> Database -> Connection string (URI)
# Keep this server-side. Never put the database URI in frontend/.env.
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Optional: Supabase Storage values for a future hosted image store.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_SECRET_KEY=<server-only-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Browser client settings. These names are read by Vite from the repository root.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
